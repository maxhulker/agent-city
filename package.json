{
  "name": "agent-city",
  "version": "0.1.1",
  "private": true,
  "description": "Watch every Claude Code session on this machine at work in an isometric city",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo": "node src/server.ts --demo",
    "app": "node src/app.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "test": "node --test test/*.test.ts",
    "connect": "node src/install.ts",
    "disconnect": "node src/install.ts --uninstall",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1",
    "notifications": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/notifications.ps1",
    "icon": "node scripts/make-icon.mjs assets/agent-city.ico assets/agent-city-preview.bmp assets"
  }
}
