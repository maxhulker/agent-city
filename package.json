{
  "name": "agent-city",
  "version": "0.1.0",
  "private": true,
  "description": "Watch every Claude Code session on this machine at work in an isometric Manhattan",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test test/*.test.ts",
    "connect": "node src/install.ts",
    "disconnect": "node src/install.ts --uninstall",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1",
    "icon": "node scripts/make-icon.mjs assets/agent-city.ico assets/agent-city-preview.bmp assets"
  }
}
